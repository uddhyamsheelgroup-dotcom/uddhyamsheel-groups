PORT=3000
NODE_ENV=development

# Optional Supabase PostgreSQL credentials
# If provided, database syncs/connects with Supabase.
# If omitted, server seamlessly uses ACID-compliant persistent SQLite database in ./data/uddhyamsheel.db
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# Initial Admin credentials for first run setup
ADMIN_USERNAME="admin"
ADMIN_PIN="1234"
